#!/usr/bin/env python3
import json
import os
import signal
import sys
from pathlib import Path


def read_text(path):
    return path.read_text().strip()


def parse_parameters(path):
    parameters = {}
    for line in path.read_text().splitlines():
        if not line or "=" not in line:
            continue
        key, value = line.split("=", 1)
        parameters[key] = value
    return parameters


def is_running(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def find_member_workers(workers_root):
    workers = []
    if not workers_root.exists():
        return workers

    for run_dir in sorted([item for item in workers_root.iterdir() if item.is_dir()]):
        for worker_dir in sorted([item for item in run_dir.iterdir() if item.is_dir()]):
            parameters_path = worker_dir / "parameters"
            pid_path = worker_dir / "worker.pid"
            if not parameters_path.exists() or not pid_path.exists():
                continue

            parameters = parse_parameters(parameters_path)
            if parameters.get("WORKER_TYPE") != "member":
                continue

            content = read_text(pid_path)
            if not content:
                continue

            pid = int(content)
            workers.append({
                "run_id": run_dir.name,
                "worker_name": worker_dir.name,
                "worker_type": parameters.get("WORKER_TYPE"),
                "worker_address": parameters.get("WORKER_ADDRESS"),
                "public_address": parameters.get("PUBLIC_ADDRESS"),
                "pid_file": str(pid_path),
                "pid": pid,
                "running": is_running(pid),
            })
    return workers


def main():
    if len(sys.argv) != 3:
        raise SystemExit("Usage: control_member_signal <term|kill> <true|false>")

    signal_name = sys.argv[1]
    dry_run = sys.argv[2].lower() == "true"

    if signal_name == "term":
        pid_signal = signal.SIGTERM
    elif signal_name == "kill":
        pid_signal = signal.SIGKILL
    else:
        raise SystemExit(f"Unsupported signal [{signal_name}]")

    simulator_home = Path(__file__).resolve().parents[2]
    workers_root = simulator_home / "workers"
    member_workers = find_member_workers(workers_root)

    targeted = []
    for worker in member_workers:
        if not worker["running"]:
            continue

        targeted.append(worker)
        if not dry_run:
            os.kill(worker["pid"], pid_signal)

    print(json.dumps({
        "simulator_home": str(simulator_home),
        "workers_root": str(workers_root),
        "signal": signal_name,
        "dry_run": dry_run,
        "target_count": len(targeted),
        "targets": targeted,
    }, sort_keys=True))


if __name__ == "__main__":
    main()
