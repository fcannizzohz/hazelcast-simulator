#!/usr/bin/env python3
import json
import os
import subprocess
import sys
from pathlib import Path


def read_text(path):
    return path.read_text().strip()


def parse_parameters(path):
    parameters = {}
    for line in path.read_text().splitlines():
        if not line or "=" not in line:
            continue
        key, value = line.split("=", 1)
        parameters[key] = value
    return parameters


def is_running(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def find_dead_member_workers(workers_root):
    workers = []
    if not workers_root.exists():
        return workers

    for run_dir in sorted([item for item in workers_root.iterdir() if item.is_dir()]):
        for worker_dir in sorted([item for item in run_dir.iterdir() if item.is_dir()]):
            parameters_path = worker_dir / "parameters"
            pid_path = worker_dir / "worker.pid"
            worker_sh = worker_dir / "worker.sh"
            if not parameters_path.exists() or not pid_path.exists() or not worker_sh.exists():
                continue

            parameters = parse_parameters(parameters_path)
            if parameters.get("WORKER_TYPE") != "member":
                continue

            content = read_text(pid_path)
            if not content:
                continue

            pid = int(content)
            if is_running(pid):
                continue

            workers.append({
                "run_id": run_dir.name,
                "worker_name": worker_dir.name,
                "worker_type": parameters.get("WORKER_TYPE"),
                "worker_address": parameters.get("WORKER_ADDRESS"),
                "public_address": parameters.get("PUBLIC_ADDRESS"),
                "pid_file": str(pid_path),
                "pid": pid,
                "running": False,
                "worker_dir": str(worker_dir),
                "worker_sh": str(worker_sh),
            })
    return workers


def restart_worker(worker):
    worker_dir = worker["worker_dir"]
    pid_file = worker["pid_file"]

    if os.path.exists(pid_file):
        os.remove(pid_file)

    command = "nohup bash worker.sh > worker.out 2> worker.err < /dev/null &"
    process = subprocess.run(
        ["bash", "-lc", command],
        cwd=worker_dir,
        capture_output=True,
        text=True,
        check=False,
    )

    result = {
        "command": command,
        "returncode": process.returncode,
        "stdout": process.stdout,
        "stderr": process.stderr,
    }

    new_pid = None
    pid_path = Path(pid_file)
    if pid_path.exists():
        content = read_text(pid_path)
        if content:
            new_pid = int(content)

    result["new_pid"] = new_pid
    result["new_running"] = is_running(new_pid) if new_pid else False
    return result


def main():
    if len(sys.argv) != 2:
        raise SystemExit("Usage: control_member_restart <true|false>")

    dry_run = sys.argv[1].lower() == "true"

    simulator_home = Path(__file__).resolve().parents[2]
    workers_root = simulator_home / "workers"
    dead_members = find_dead_member_workers(workers_root)

    restarted = []
    for worker in dead_members:
        entry = dict(worker)
        if not dry_run:
            entry["restart_result"] = restart_worker(worker)
        restarted.append(entry)

    print(json.dumps({
        "simulator_home": str(simulator_home),
        "workers_root": str(workers_root),
        "dry_run": dry_run,
        "target_count": len(restarted),
        "targets": restarted,
    }, sort_keys=True))


if __name__ == "__main__":
    main()
