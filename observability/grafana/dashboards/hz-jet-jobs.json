{
  "uid": "hz-jet-jobs",
  "title": "Jet Jobs",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {},
  "tags": [
    "hazelcast",
    "jet",
    "jobs"
  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(hz_runtime_uptime, mc_cluster)",
        "query": {
          "query": "label_values(hz_runtime_uptime, mc_cluster)",
          "refId": "SV"
        },
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "refresh": 2,
        "hide": 0,
        "current": {
          "text": "workers",
          "value": "workers"
        }
      },
      {
        "name": "member",
        "label": "Member",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(hz_runtime_uptime{mc_cluster=\"$cluster\"}, mc_member)",
        "query": {
          "query": "label_values(hz_runtime_uptime{mc_cluster=\"$cluster\"}, mc_member)",
          "refId": "SV"
        },
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "hide": 0,
        "current": {}
      },
      {
        "name": "jobName",
        "label": "Jet Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(hz_jobs_submitted{mc_cluster=\"$cluster\"}, jobName)",
        "query": {
          "query": "label_values(hz_jobs_submitted{mc_cluster=\"$cluster\"}, jobName)",
          "refId": "SV"
        },
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "hide": 0,
        "current": {}
      },
      {
        "name": "vertex",
        "label": "Vertex",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(hz_queuesSize{mc_cluster=\"$cluster\", jobName=~\"$jobName\"}, vertex)",
        "query": {
          "query": "label_values(hz_queuesSize{mc_cluster=\"$cluster\", jobName=~\"$jobName\"}, vertex)",
          "refId": "SV"
        },
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "hide": 0,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "options": {
        "mode": "markdown",
        "content": "## Hazelcast Jet Jobs\n\nOptional Jet dashboard for Simulator scenarios that run Jet jobs and expose Jet metrics through Management Center.\n\n**Key questions this dashboard answers:**\n- Are Jet jobs being submitted, started, completed, or failed?\n- Are tasklets active and queues filling up?\n- Are watermarks delayed or event time stale?\n- Are snapshots growing in bytes or keys?\n\n**Important:** the current live validation target did not expose Jet metric families such as `hz_jobs_*`, `hz_taskletCount`, `hz_queuesSize`, `hz_queuesCapacity`, `hz_lastForwardedWmLatency`, `hz_topObservedWm`, `hz_snapshotBytes`, or `hz_snapshotKeys`. This dashboard is provisioned for Jet workloads but will stay empty or zero until those metrics exist."
      },
      "transparent": true
    },
    {
      "id": 2,
      "type": "row",
      "title": "Job Lifecycle",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Jobs Submitted",
      "description": "Total submitted Jet jobs.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(hz_jobs_submitted{mc_cluster=\"$cluster\", mc_member=~\"$member\"}) or vector(0)",
          "legendFormat": "submitted",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Jobs Completed",
      "description": "Successfully completed Jet jobs.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 9,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(hz_jobs_completedSuccessfully{mc_cluster=\"$cluster\", mc_member=~\"$member\"}) or vector(0)",
          "legendFormat": "success",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Jobs Failed",
      "description": "Jet jobs completed with failure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(hz_jobs_completedWithFailure{mc_cluster=\"$cluster\", mc_member=~\"$member\"}) or vector(0)",
          "legendFormat": "failed",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Active Tasklets",
      "description": "Current active tasklets.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 9,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hz_taskletCount{mc_cluster=\"$cluster\", mc_member=~\"$member\"}) or vector(0)",
          "legendFormat": "tasklets",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Job Lifecycle Rate",
      "description": "Lifecycle event rates from Jet job counters.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(hz_jobs_submitted{mc_cluster=\"$cluster\", mc_member=~\"$member\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "submitted/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(hz_jobs_executionStarted{mc_cluster=\"$cluster\", mc_member=~\"$member\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "execution started/s",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(hz_jobs_executionCompleted{mc_cluster=\"$cluster\", mc_member=~\"$member\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "execution completed/s",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(hz_jobs_completedSuccessfully{mc_cluster=\"$cluster\", mc_member=~\"$member\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "success/s",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(hz_jobs_completedWithFailure{mc_cluster=\"$cluster\", mc_member=~\"$member\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "failure/s",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Pipeline Backpressure",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Queue Fill % by Vertex",
      "description": "Max queue fill ratio over processors by job and vertex.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (jobName, vertex) ((hz_queuesSize{mc_cluster=~\"$cluster\", jobName=~\"$jobName\", vertex=~\"$vertex\"} / on (jobName, vertex, exec, proc) hz_queuesCapacity{mc_cluster=~\"$cluster\"}) * 100) or vector(0)",
          "legendFormat": "{{jobName}} {{vertex}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Items In vs Out",
      "description": "Received and emitted item rates by vertex. A sustained positive gap suggests a bottleneck.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (jobName, vertex) (rate(hz_receivedCount{mc_cluster=~\"$cluster\", jobName=~\"$jobName\", vertex=~\"$vertex\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "in {{jobName}} {{vertex}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (jobName, vertex) (rate(hz_emittedCount{mc_cluster=~\"$cluster\", jobName=~\"$jobName\", vertex=~\"$vertex\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "out {{jobName}} {{vertex}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Bottleneck Gap by Vertex",
      "description": "Top positive received-minus-emitted item rate by vertex.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, clamp_min(sum by (jobName, vertex) (rate(hz_receivedCount{mc_cluster=~\"$cluster\", jobName=~\"$jobName\", vertex=~\"$vertex\"}[$__rate_interval])) - sum by (jobName, vertex) (rate(hz_emittedCount{mc_cluster=~\"$cluster\", jobName=~\"$jobName\", vertex=~\"$vertex\"}[$__rate_interval])), 0)) or vector(0)",
          "legendFormat": "{{jobName}} {{vertex}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Watermarks and Snapshots",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Watermark Delay",
      "description": "Maximum forwarded watermark latency by vertex.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (jobName, vertex) (((hz_lastForwardedWmLatency{unit=\"MS\", mc_cluster=~\"$cluster\", jobName=~\"$jobName\", vertex=~\"$vertex\"} >= 0) and (hz_lastForwardedWmLatency{unit=\"MS\", mc_cluster=~\"$cluster\", jobName=~\"$jobName\", vertex=~\"$vertex\"} < 2000000000000))) or vector(0)",
          "legendFormat": "{{jobName}} {{vertex}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Event-time Staleness",
      "description": "Current wall clock minus top observed watermark by vertex.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (jobName, vertex) (clamp_min((time() * 1000) - (((hz_topObservedWm{unit=\"MS\", mc_cluster=~\"$cluster\", jobName=~\"$jobName\", vertex=~\"$vertex\"} > 0) and (hz_topObservedWm{unit=\"MS\", mc_cluster=~\"$cluster\", jobName=~\"$jobName\", vertex=~\"$vertex\"} < 2000000000000))), 0)) or vector(0)",
          "legendFormat": "{{jobName}} {{vertex}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Snapshot Bytes and Keys",
      "description": "Snapshot footprint by job and vertex.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (jobName, vertex) (hz_snapshotBytes{mc_cluster=~\"$cluster\", jobName=~\"$jobName\", vertex=~\"$vertex\"}) or vector(0)",
          "legendFormat": "bytes {{jobName}} {{vertex}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (jobName, vertex) (hz_snapshotKeys{mc_cluster=~\"$cluster\", jobName=~\"$jobName\", vertex=~\"$vertex\"}) or vector(0)",
          "legendFormat": "keys {{jobName}} {{vertex}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ]
}
